import os
import time
import requests

# Set up your API credentials
API_BASE_URL = os.getenv("AI_VIDEO_API_URL", "https://api.example-video-provider.com/v1")
API_KEY = os.getenv("AI_VIDEO_API_KEY", "your_api_key_here")

headers = {
    "Authorization": f"Bearer {API_KEY}",
    "Content-Type": "application/json",
}

def create_video_task(prompt: str, duration: int = 6, resolution: str = "1080p") -> str:
    """Submits a text-to-video generation job and returns the task ID."""
    endpoint = f"{API_BASE_URL}/videos/generations"
    
    payload = {
        "prompt": prompt,
        "duration": duration,       # Typical lengths range from 4 to 10 seconds
        "resolution": resolution,   # E.g., "720p", "1080p", "4k"
        "aspect_ratio": "16:9",
        "fps": 24
    }
    
    print(f"Sending prompt to video model: '{prompt}'")
    response = requests.post(endpoint, json=payload, headers=headers)
    
    if response.status_code not in [200, 201]:
        raise RuntimeError(f"Error starting video generation ({response.status_code}): {response.text}")
        
    data = response.json()
    task_id = data.get("task_id") or data.get("id")
    print(f"Generation task successfully queued. Task ID: {task_id}")
    return task_id

def poll_and_download_video(task_id: str, output_filename: str = "output.mp4", poll_interval: int = 8):
    """Polls the task status until completion and downloads the resulting MP4 video."""
    status_endpoint = f"{API_BASE_URL}/videos/tasks/{task_id}"
    
    print("Waiting for video rendering to complete (this may take up to a minute)...")
    

        if response.status_code != 200:
            print(f"Warning: Failed to fetch status check ({response.status_code}), retrying...")
            time.sleep(poll_interval)
            continue
            
        status_data = response.json()
        state = status_data.get("status") # Expected: 'queued', 'processing', 'completed', 'failed'
        
        print(f" > Current status: {state}")
        
        if state == "completed":
            video_url = status_data.get("video_url") or status_data.get("url")
            print(f"Video ready! Downloading from: {video_url}")
            
            # Stream download the binary video file
            video_res = requests.get(video_url, stream=True)
            if video_res.status_code == 200:
                with open(output_filename, "wb") as f:
                    for chunk in video_res.iter_content(chunk_size=8192):
                        f.write(chunk)
                print(f"Success! Video saved locally as '{output_filename}'")
                return output_filename
            else:
                raise RuntimeError(f"Failed to download video file. Status code: {video_res.status_code}")
                
        elif state == "failed":
            error_msg = status_data.get("error", "Unknown server-side error")
            raise RuntimeError(f"Video generation failed: {error_msg}")
            
        time.sleep(poll_interval)

if __name__ == "__main__":
    # Example execution flow
    prompt_text = (
        "Cinematic drone shot soaring through a glowing canyon of neon glass towers, "
        "futuristic sci-fi city at twilight, 8k resolution, smooth camera movement."
    )
    
    try:
        task_id = create_video_task(prompt=prompt_text, duration=6, resolution="1080p")
        poll_and_download_video(task_id, output_filename="cyberpunk_city.mp4")
    except Exception as e:
        print(f"An error occurred: {e}")